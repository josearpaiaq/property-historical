# ===========================================
# Docker Compose Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=property_historical
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRATION=7d
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# AWS (optional for local dev, required for S3 attachments)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===========================================
# GitHub Secrets (configure in repo settings)
# ===========================================
# AWS_ACCESS_KEY_ID        - IAM user access key
# AWS_SECRET_ACCESS_KEY    - IAM user secret key
# AWS_REGION               - e.g. us-east-1
# ECR_REPOSITORY           - ECR repo name (e.g. property-historical-backend)
# ECS_CLUSTER              - ECS cluster name
# ECS_SERVICE              - ECS service name
# API_URL                  - Backend API URL for frontend build
# FRONTEND_BUCKET          - S3 bucket name for frontend
# CLOUDFRONT_DISTRIBUTION_ID - CloudFront distribution ID
