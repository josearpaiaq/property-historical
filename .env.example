# ===========================================
# Local Development Environment Variables
# Copy this file to .env and fill in the values
# ===========================================

# PostgreSQL (local Docker container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=property_historical
POSTGRES_PORT=5432

# ===========================================
# Production Environment Variables
# (configured in Railway / Vercel dashboards)
# ===========================================
#
# Railway (backend):
#   DATABASE_URL     - Neon connection string (postgres://...@...neon.tech/...)
#   JWT_SECRET       - Secure random string (32+ chars)
#   JWT_EXPIRATION   - Token expiry (e.g. 7d)
#   AWS_REGION       - us-east-1
#   AWS_S3_BUCKET    - S3 bucket name for attachments
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   FRONTEND_URL     - Vercel frontend URL (for CORS)
#   NODE_ENV         - production
#   PORT             - 3000
#
# Vercel (frontend):
#   VITE_API_URL     - Railway backend URL (e.g. https://your-app.railway.app/api)
#
# ===========================================
# GitHub Secrets (for CI/CD workflow)
# ===========================================
# RAILWAY_TOKEN              - Railway project deploy token
# VERCEL_TOKEN               - Vercel personal access token
