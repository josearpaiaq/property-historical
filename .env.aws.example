# ============================================
# AWS Infrastructure Configuration
# ============================================
# Copy this file to .env.aws and fill with your real values.
# This file is used by scripts/deploy.sh
# DO NOT commit .env.aws (it's in .gitignore)
# ============================================

## Region
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id

## ECR (Container Registry)
ECR_REPOSITORY=property-historical-backend

## ECS (Backend Service)
ECS_CLUSTER=property-historical
ECS_SERVICE=backend

## S3 Buckets
S3_FRONTEND_BUCKET=your-frontend-bucket-name
S3_ATTACHMENTS_BUCKET=your-attachments-bucket-name

## CloudFront
CLOUDFRONT_DISTRIBUTION_ID=your-distribution-id
