# Server
PORT=3000
NODE_ENV=development

# Database (local PostgreSQL for dev, Neon for production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/property_historical

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# AWS (S3 only - for file attachments)
AWS_REGION=us-east-1
AWS_S3_BUCKET=property-historical-attachments
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173
